{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SlipSurface LE",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "SlipSurface LE — ankrajlı örnek",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "examples/ankrajli_yarma.slp.json"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "SlipSurface LE — örnek seç (--example)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--example",
                "${input:example}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "SlipSurface LE — açık dosyayı aç (.slp.json)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "${file}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Ortam kontrolü",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--check"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Testler (pytest)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "-p",
                "no:cacheprovider"
            ]
        }
    ],
    "inputs": [
        {
            "id": "example",
            "type": "pickString",
            "description": "Örnek proje",
            "options": [
                "Basit şev (10 m, 2H:1V)",
                "ACADS EX1(a)",
                "Katmanlı şev + YASS",
                "Ankrajlı yarma + sürşarj",
                "Gerilme çatlaklı şev",
                "Zemin çivisi + püskürtme beton",
                "Drenajsız kil / Undrained clay",
                "Power-law envelope",
                "Sismik / Seismic kh=0.15"
            ]
        }
    ]
}
