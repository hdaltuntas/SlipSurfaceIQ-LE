Name:           slipsurface-iq-le
Version:        @VERSION@
Release:        1%{?dist}
Summary:        2D limit equilibrium slope stability analysis
License:        AGPL-3.0-or-later
URL:            https://github.com/hdaltuntas/SlipSurfaceIQ-LE
Source0:        payload.tar.gz
BuildArch:      x86_64
AutoReqProv:    no
Requires:       @REQUIRES@

# Preserve the already linked, tested PyInstaller runtime and bundled libraries.
%global debug_package %{nil}
%global __os_install_post %{nil}

%description
SlipSurfaceIQ LE provides a desktop CAD interface for limit equilibrium slope
stability analysis. Python, Qt and the scientific runtime are bundled.

%prep
%setup -q -n payload

%build

%install
mkdir -p %{buildroot}
cp -a . %{buildroot}/

%files
/opt/slipsurface-iq-le
/usr/bin/slipsurface
/usr/share/applications/slipsurface.desktop
/usr/share/icons/hicolor/256x256/apps/slipsurface-iq-le.png
%license /usr/share/licenses/slipsurface-iq-le
